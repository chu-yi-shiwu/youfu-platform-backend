# 优服家后端环境变量模板（P0-2）
#
# 用法：复制为 .env（本地）或 .env.pilot（生产），逐项替换为真实值。
#   cp .env.example .env
# 严禁把真实密钥提交进仓库；本文件只保留占位符。
#
# 生产最小启动集合（缺 JWT_SECRET / PG* 会启动失败或全量 500）：
#   NODE_ENV=production
#   AUTH_MODE=prod
#   JWT_SECRET=<32+ 位随机串>
#   PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
#   ENV_FILE=/opt/youfu/backend/.env

# ---------- 运行模式 ----------
NODE_ENV=production
# dev：本地联调（权限恒放行，仅限本机）；prod：生产（缺失 JWT_SECRET 拒绝启动）
AUTH_MODE=prod
# production 下默认加载 .env.pilot；systemd 建议显式指定绝对路径
ENV_FILE=/opt/youfu/backend/.env
PORT=4001

# ---------- 数据库（运行时角色 youfu_app，受 RLS 约束） ----------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=youfu
PGUSER=youfu_app
PGPASSWORD=change_me
# 云数据库要求 TLS 时设为 require；本机可留空
PGSSLMODE=

# ---------- 认证 ----------
# 生产必填：JWT 签名密钥（请用 openssl rand -hex 32 生成，勿复用示例值）
JWT_SECRET=change_me_to_a_random_32_bytes_hex
JWT_TTL_SECONDS=604800
# 未带租户头的请求落到哪个租户（试点填资兴市人民医院的租户 id）
DEFAULT_LOGIN_TENANT=
# 邀请码 HMAC 盐；不填会回退 APP_SECRET_SALT 或内置常量（生产建议显式设置）
INVITE_SALT=change_me_invite_salt
APP_SECRET_SALT=change_me_app_secret_salt

# ---------- 前端静态托管（单进程试点模式） ----------
# 1=由后端托管前端 dist（配合 nginx 反代）；0=只提供 API
SERVE_STATIC=0
# 不填时默认 ../05_frontend/dist（相对 dist/server.js）
STATIC_DIR=

# ---------- 上传 ----------
UPLOAD_DIR=/opt/youfu/backend/uploads
# 媒体脱敏网关（可选；留空则关闭）
MEDIA_MASK_URL=

# ---------- 微信小程序 / 公众号（按试点启用情况填写） ----------
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
WX_MP_APPID=
WX_MP_SECRET=
WX_MP_TEMPLATE_ID=
# 模板 data key 顺序：默认 thing1,thing2,thing3,thing4；按实际模板覆盖
WX_MP_TEMPLATE_KEYS=
MP_APPID=
MP_APPSECRET=
MP_SECRET=

# ---------- 通知网关（留空 = 诚实 stub，只落库不外发） ----------
SMS_GATEWAY=
PUSH_GATEWAY=

# ---------- LLM / 向量（可选；不填则相关能力降级） ----------
LLM_DEFAULT_MODEL=
LLM_TIMEOUT_MS=15000
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_PRICE_PER_1K_USD=0

# ---------- 调度 / 业务参数（一般无需改） ----------
CLAIM_HALL_TIMEOUT_MIN=30
REPAIR_RETENTION_DAYS=365
MODEL_AUTO_TUNE=0
WORKFLOW_CONFIG_OWNER=tenant
ENERGY_DISPATCH_TENANT=
ENERGY_SERVICE_KEY=
ENERGY_WEBHOOK_SECRET=

# ---------- 初始化脚本专用（仅 npm run init-db / seed:accounts 时需要） ----------
# 数据库属主账号（DDL/RLS 必须由属主执行；运行时 youfu_app 无权限）
PGADMINUSER=postgres
PGADMINPASSWORD=change_me_admin_password
YOUFU_APP_PASSWORD=change_me_youfu_app_password
SEED_TENANT=
SEED_ADMIN_PWD=
SEED_OPERATOR_PWD=
