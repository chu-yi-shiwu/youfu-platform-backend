{
  "name": "youfu-backend-m1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "优服家业务流程平台 后端最小闭环（M3 Step1）：接单->派单->处理->完成，4 接口 + 最小落库",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:pilot": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "init-db": "tsx scripts/init-db.ts",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "seed:platform": "node scripts/seed-platform.cjs",
    "preflight": "tsx scripts/pilot-preflight.ts",
    "seed:workflow": "tsx scripts/seed-workflow-def.ts",
    "seed:workflow:reset": "tsx scripts/seed-workflow-def.ts --reset",
    "seed:pilot-demo": "node scripts/seed-pilot-demo.mjs",
    "e2e:pilot": "node scripts/pilot-e2e.mjs",
    "e2e:pilot:role": "node scripts/pilot-role-action-e2e.mjs",
    "e2e:pilot:media": "node scripts/pilot-media-e2e.mjs",
    "e2e:pilot:security": "node scripts/pilot-security-e2e.mjs",
    "e2e:pilot:perf": "node scripts/pilot-perf-e2e.mjs",
    "e2e:pilot:list1000": "node scripts/pilot-list-1000-e2e.mjs",
    "e2e:pilot:upload5mb": "node scripts/pilot-upload-5mb-e2e.mjs",
    "e2e:pilot:full": "node scripts/pilot-full-business-e2e.mjs",
    "e2e:pilot:uat-all": "node scripts/pilot-uat-all-modules-e2e.mjs",
    "register:webhook": "node scripts/register-webhook.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release-gate": "tsx scripts/releaseGate.ts",
    "release-gate:live": "tsx scripts/releaseGate.ts --live-audit",
    "seed:energy-collection": "tsx scripts/seed-energy-collection-def.ts",
    "seed:energy-collection:reset": "tsx scripts/seed-energy-collection-def.ts --reset",
    "preflight:asset-workflow": "node scripts/asset-workflow-preflight.mjs",
    "manifest": "node scripts/release-manifest.mjs",
    "baseline": "node scripts/release-baseline.mjs",
    "diag:wechat": "node scripts/wechat-notify-diagnose.mjs",
    "diag:wechat-template": "node scripts/wechat-template-verify.mjs",
    "audit:workbench-stats": "node scripts/audit-workbench-stats.mjs",
    "audit:duplicate-workers": "node scripts/audit-duplicate-workers.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "tsx": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "qs": "^6.14.0"
  }
}
